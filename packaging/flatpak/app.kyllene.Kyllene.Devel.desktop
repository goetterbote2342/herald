[Desktop Entry]
Type=Application
Name=Kyllene (Development)
Name[de]=Kyllene (Entwicklung)
Name[fr]=Kyllene (développement)
Name[es]=Kyllene (desarrollo)
Name[pt_BR]=Kyllene (desenvolvimento)
Name[zh_CN]=Kyllene（开发版）
Name[hu]=Kyllene (fejlesztői verzió)
Comment=Client for Hermes Agent
Comment[de]=Client für Hermes Agent
Comment[fr]=Client pour Hermes Agent
Comment[es]=Cliente para Hermes Agent
Comment[pt_BR]=Cliente para o Hermes Agent
Comment[zh_CN]=Hermes Agent 客户端
Comment[hu]=Kliens a Hermes Agenthez
Exec=kyllene %u
Icon=app.kyllene.Kyllene.Devel
Terminal=false
